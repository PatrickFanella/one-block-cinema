{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oneblockcinema.app/schemas/film-template-v1.schema.json",
  "title": "One-Block Cinema Film Template Catalog v1",
  "type": "array",
  "minItems": 10,
  "maxItems": 10,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion", "id", "title", "subtitle", "outcome", "theme",
      "difficulty", "aspectRatio", "durationTargetSeconds", "tags",
      "shotPrompts", "guidance", "assembly"
    ],
    "properties": {
      "schemaVersion": { "const": 1 },
      "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "title": { "type": "string", "minLength": 1 },
      "subtitle": { "type": "string", "minLength": 1 },
      "outcome": { "type": "string", "minLength": 1 },
      "theme": { "enum": ["noir", "romance", "documentary", "horror", "dream"] },
      "difficulty": { "enum": ["beginner", "intermediate"] },
      "aspectRatio": { "enum": ["9:16", "1:1", "16:9", "4:5"] },
      "durationTargetSeconds": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min", "ideal", "max"],
        "properties": {
          "min": { "type": "integer", "minimum": 60, "maximum": 180 },
          "ideal": { "type": "integer", "minimum": 60, "maximum": 180 },
          "max": { "type": "integer", "minimum": 60, "maximum": 180 }
        }
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      },
      "shotPrompts": {
        "type": "array",
        "minItems": 5,
        "maxItems": 9,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "index", "title", "structureRole", "direction", "hint", "icon", "targetSeconds"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            "index": { "type": "integer", "minimum": 0 },
            "title": { "type": "string", "minLength": 1 },
            "structureRole": { "type": "string", "minLength": 1 },
            "direction": { "type": "string", "minLength": 1 },
            "hint": { "type": "string", "minLength": 1 },
            "icon": { "type": "string", "minLength": 1 },
            "targetSeconds": { "type": "integer", "minimum": 1, "maximum": 60 }
          }
        }
      },
      "guidance": {
        "type": "object",
        "additionalProperties": false,
        "required": ["structure", "capture", "assembly", "export"],
        "properties": {
          "structure": { "type": "string", "minLength": 1 },
          "capture": { "type": "string", "minLength": 1 },
          "assembly": { "type": "string", "minLength": 1 },
          "export": { "type": "string", "minLength": 1 }
        }
      },
      "assembly": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pacingStyle", "editStyle", "useAmbientSoundtrack"],
        "properties": {
          "pacingStyle": { "enum": ["quick_cuts", "slow_cinema", "rhythmic"] },
          "editStyle": { "enum": ["standard", "silent_film", "voiceover_diary"] },
          "useAmbientSoundtrack": { "type": "boolean" }
        }
      }
    }
  }
}
