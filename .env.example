PROJECT_NAME=one-block-cinema
APP_ENV=development
HOST=0.0.0.0
PORT=8080

# Server-only Supabase/Postgres settings. Never add these to the iOS target.
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=

# Public moderation-console configuration (anon key only; never service role).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only published media settings.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Rollout gates default off.
FEATURE_COMMUNITY=false
FEATURE_AI_COACH=false

# AI provider setup is intentionally deferred. Do not add an API key to the app.
