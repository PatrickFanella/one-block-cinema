default_platform(:ios)

platform :ios do
  desc "Run the deterministic simulator test suite"
  lane :tests do
    sh("make ios-test")
  end

  desc "Create an unsigned archive for CI validation"
  lane :archive_check do
    sh("make archive-check")
  end

  desc "Build and upload a signed beta; requires CI-managed credentials"
  lane :beta do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT"),
      is_key_content_base64: true
    )
    build_app(
      project: "ios/OneBlockCinema.xcodeproj",
      scheme: "OneBlockCinema",
      export_method: "app-store",
      clean: true
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
